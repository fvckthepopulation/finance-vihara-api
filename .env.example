APP_NAME="Vihara Finance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8400

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres native (Mac brew @16) — adjust for staging/prod per
# accounting_project_conventions.md.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vihara_finance
DB_USERNAME=vihara
DB_PASSWORD=change-me

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# CORS / Sanctum stateful — set after deploy
FRONTEND_URL=http://localhost:3400
SANCTUM_STATEFUL_DOMAINS=localhost:3400

# Payment gateway (Phase 4) — mock manual webhook for MVP
PAYMENT_GATEWAY_MOCK=true
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# KM Finance (KalyanaMitta) webhook M2M shared secret — generate: openssl rand -hex 32
KM_WEBHOOK_TOKEN=
